{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://store-api.daysam.co/api/$1" },
    { "source": "/media/(.*)", "destination": "https://store-api.daysam.co/media/$1" },
    { "source": "/admin/(.*)", "destination": "https://store-api.daysam.co/admin/$1" },
    { "source": "/static/(.*)", "destination": "https://store-api.daysam.co/static/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
